# Which model to start from. A Hugging Face repo id, a local folder, or a single
# .safetensors checkpoint file (Stable Diffusion 1.5 or SDXL, e.g. an uncensored community fine-tune).
BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# Only for single-file checkpoints, if the app guesses the type wrong: sdxl or sd15
# BASE_MODEL_ARCH=sdxl

# Training steps: more = learns your pictures more strongly, but takes longer.
TRAINING_STEPS=1000
# Steps per generated picture: more = more detail, but slower.
GENERATION_STEPS=30

# Set to 1 if your graphics card has less than ~10 GB of memory (it's turned on automatically for small cards).
# LOW_VRAM=1

# Python to use. Default: .venv made by "npm run setup".
# PYTHON=/path/to/python

PORT=3000
# Set to 1 to try the app with fake images and no AI installed.
# DEMO_MODE=1
