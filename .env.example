# Get a token at https://replicate.com/account/api-tokens
# Leave empty (or set DEMO_MODE=1) to run in free demo mode with fake images.
REPLICATE_API_TOKEN=

# Trainer used to fine-tune the model on your pictures (FLUX LoRA trainer).
REPLICATE_TRAINER=ostris/flux-dev-lora-trainer

# Training steps: more = learns your pictures more strongly, but takes longer and costs more.
TRAINING_STEPS=1000

PORT=3000
# DEMO_MODE=1
